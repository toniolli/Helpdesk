# Porta publicada no computador
API_PORT=8080

# Ambiente da API
ASPNETCORE_ENVIRONMENT=Production

# Oracle externo. Substitua todos os valores antes de iniciar a API.
ConnectionStrings__ORACLE=User Id=SEU_USUARIO;Password=SUA_SENHA;Data Source=SEU_SERVIDOR:1521/SEU_SERVICO

# Inicialização do banco. Mantenha false nas execuções normais.
DatabaseInitialization__Enabled=false

# Autenticação JWT
Jwt__Key=ALTERE_POR_UMA_CHAVE_SECRETA_DE_AO_MENOS_32_CARACTERES
Jwt__Issuer=Helpdesk
Jwt__Audience=Helpdesk
Jwt__AccessTokenExpirationMinutes=10
Jwt__NormalInactivityMinutes=30

# Endereço do frontend autorizado a acessar a API
Cors__AllowedOrigins__0=http://localhost:5173

# Administrador inicial. Utilizado somente quando a inicialização está habilitada.
SeedIdentity__AdminUserName=
SeedIdentity__AdminEmail=
SeedIdentity__AdminPassword=

# Serviço SMTP opcional
EmailService__Servidor=smtp.seudominio.com
EmailService__Porta=587
EmailService__Email=
EmailService__Senha=
EmailService__Remetente=Help Desk
